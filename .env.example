# ─────────────────────────────────────────────────────────────
#  Mesa5 · Variables de entorno
#  Copia este archivo como `.env.local` y rellena los valores.
#  NUNCA subas `.env.local` a GitHub (ya está en .gitignore).
#  Las variables que empiezan por NEXT_PUBLIC_ se ven en el navegador:
#  no pongas nunca una clave secreta en una de ellas.
# ─────────────────────────────────────────────────────────────

# ── Sitio (fase 1A) ──────────────────────────────────────────
# URL pública sin barra final. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Email de contacto que aparece en la web
NEXT_PUBLIC_CONTACT_EMAIL=hola@mesa5.app

# ── Precios mostrados en la web, en euros (fase 1A) ──────────
# Deben coincidir con los precios creados en Stripe (fase 1F).
NEXT_PUBLIC_PRICE_BASIC_EUR=19
NEXT_PUBLIC_PRICE_PRO_EUR=39
NEXT_PUBLIC_PRICE_MULTI_EUR=79

# ── Supabase (fase 1B) ───────────────────────────────────────
# Supabase → tu proyecto → botón "Connect" (o Project Settings → API Keys).
# Estas dos son públicas: la seguridad la da Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (Si tu proyecto solo muestra la "anon key" clásica, puedes usar
#  NEXT_PUBLIC_SUPABASE_ANON_KEY en lugar de la anterior.)

# ── IA de Anthropic (fase 1C) ────────────────────────────────
# SECRETA: ponla solo en Vercel (Sensitive) y, si pruebas en local, en .env.local.
ANTHROPIC_API_KEY=
# Opcionales: modelo rápido (respuestas) y potente (informe mensual)
AI_MODEL_FAST=claude-haiku-5-5
AI_MODEL_SMART=claude-opus-5-5
# Cambio USD → EUR para calcular el coste de cada llamada
AI_USD_TO_EUR=0.9

# ── Próximas fases (se rellenarán cuando lleguemos) ──────────
# Supabase admin (1F): SUPABASE_SECRET_KEY  ← secreta, solo en Vercel
# Stripe (1F):      STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_BASIC, STRIPE_PRICE_PRO, STRIPE_PRICE_MULTI
# Turnstile (1G):   NEXT_PUBLIC_TURNSTILE_SITE_KEY, TURNSTILE_SECRET_KEY
# Admin (1H):       ADMIN_EMAILS
# Emails (2A):      RESEND_API_KEY, EMAIL_FROM
# Google API (3):   FEATURE_GOOGLE_API=false
